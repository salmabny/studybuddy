<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header violet pleine largeur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/primary_color"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white"/>

            <TextView
                android:layout_marginStart="16dp"
                android:text="NOUVEL ÉVÉNEMENT"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Conteneur avec padding pour le formulaire -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Formulaire avec coins arrondis et ombre -->
            <LinearLayout
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_form_bg"
                android:padding="20dp"
                android:elevation="6dp">

                <!-- Titre -->
                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Titre de l'événement"
                    android:background="@drawable/rounded_edittext"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Type -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Type:"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rgType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <RadioButton
                        android:id="@+id/rbCours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cours" />

                    <RadioButton
                        android:id="@+id/rbDevoir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Devoir"
                        android:layout_marginStart="16dp"/>

                    <RadioButton
                        android:id="@+id/rbExamen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Examen"
                        android:layout_marginStart="16dp"/>
                </RadioGroup>

                <!-- Date -->
                <EditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Sélectionner une date"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/rounded_edittext"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Heure -->
                <EditText
                    android:id="@+id/etHour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Sélectionner l'heure"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/rounded_edittext"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Matière -->
                <EditText
                    android:id="@+id/etSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Matière"
                    android:background="@drawable/rounded_edittext"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Description -->
                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Description"
                    android:minLines="3"
                    android:background="@drawable/rounded_edittext"
                    android:padding="12dp"/>
            </LinearLayout>

            <!-- Bouton créer avec coins arrondis et effet clic -->
            <Button
                android:id="@+id/btnCreate"
                android:layout_marginTop="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CRÉER L'ÉVÉNEMENT"
                android:backgroundTint="@color/primary_color"
                android:textColor="@color/white"
                android:padding="14dp"
                android:stateListAnimator="@null"
                android:background="@drawable/rounded_button"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>